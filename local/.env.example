# Compose isolation — change these to run multiple stacks side by side.
COMPOSE_PROJECT_NAME=paperclip-local
PAPERCLIP_HOST_PORT=3100

# Paperclip server
DATABASE_URL=postgres://paperclip:paperclip@db:5432/paperclip
PORT=3100
HOST=0.0.0.0
SERVE_UI=true
PAPERCLIP_HOME=/paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG=/paperclip/instances/default/config.json
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# Docker cannot see the host Tailscale interface, so the process listens on
# 0.0.0.0 inside the container (lan). Compose publishes that port only on
# PAPERCLIP_PUBLISH_HOST. Set it to `tailscale ip -4`.
PAPERCLIP_BIND=lan
PAPERCLIP_PUBLISH_HOST=100.x.y.z
# Replace mac-mini.tailnet.ts.net with this Mini's Tailscale MagicDNS name.
PAPERCLIP_PUBLIC_URL=http://mac-mini.tailnet.ts.net:3100
PAPERCLIP_API_URL=http://mac-mini.tailnet.ts.net:3100
PAPERCLIP_ALLOWED_HOSTNAMES=mac-mini.tailnet.ts.net
PAPERCLIP_MIGRATION_AUTO_APPLY=true
PAPERCLIP_DB_BACKUP_ENABLED=false
HEARTBEAT_SCHEDULER_ENABLED=true
# Set true after the first admin exists.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Generate locally (do not copy from GCP Secret Manager):
#   openssl rand -hex 32
#   openssl rand -base64 32   # for PAPERCLIP_SECRETS_MASTER_KEY (32-byte key, base64)
BETTER_AUTH_SECRET=replace-me
PAPERCLIP_SECRETS_MASTER_KEY=replace-me
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace-me
PAPERCLIP_AGENT_JWT_SECRET=replace-me

# S3 storage via MinIO
PAPERCLIP_STORAGE_PROVIDER=s3
PAPERCLIP_STORAGE_S3_BUCKET=paperclip-uploads
PAPERCLIP_STORAGE_S3_REGION=us-east-1
PAPERCLIP_STORAGE_S3_ENDPOINT=http://minio:9000
PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
PAPERCLIP_STORAGE_S3_PREFIX=uploads
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# LiteLLM only (provider keys never go on Paperclip as provider credentials).
# Paperclip receives LITELLM_MASTER_KEY as GEMINI_API_KEY via compose.yaml.
GEMINI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
LITELLM_MASTER_KEY=replace-me
